# ═══════════════════════════════════════════════════════
#  Coders War — Production Environment Variables
#  Bu faylni ko'chirib, .env.production nomini bering
#  va BARCHA qiymatlarni to'ldiring!
#
#  cp .env.production.example .env.production
# ═══════════════════════════════════════════════════════

# ── Django ──────────────────────────────────────────────
# Yangi kalit yaratish:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_50_CHAR_STRING

DEBUG=False
ALLOWED_HOSTS=coderswar.uz,www.coderswar.uz,YOUR_SERVER_IP

# ── Database (Docker ichida db servisi) ──────────────────
DB_NAME=coderswar
DB_USER=coderswar_user
DB_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# ── Redis (Docker ichida redis servisi) ──────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://coderswar.uz,https://www.coderswar.uz

# ── Email (Gmail SMTP) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
# Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_gmail_app_password

# ── Judge0 (C# kodni baholash) ───────────────────────────
# RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here

# ── OpenAI (AI ko'mak, ixtiyoriy) ───────────────────────
OPENAI_API_KEY=sk-your_openai_key_here
